---
/* ===== LE GÉNÉRIQUE =====
   L'intro Marvel Studios avec les vrais logos mensuels du bar : le défilé de
   cases traverse « DAILY POP » de plus en plus vite — les logos ne vivent QUE
   dans les lettres (les deux bandes obliques de vignettes d'origine ont été
   retirées le 2026-09-08, décision utilisateur : « pas terrible sauf dans la
   typo »), le nom se fige en blanc, « SOCIETY » se compose, la title card du
   mois apparaît. START transforme ensuite le hero en borne plein écran
   (allumage GSAP dans borne.ts).
   Desktop : scène épinglée, scrubée au scroll (rejouable). Mobile : intro
   courte au chargement. Sans JS / reduced-motion : état final statique. */
import { MONTAGE, MONTAGE_HD } from '../data/logos';
import { LICENCE_DU_MOIS, IDENTITE } from '../data/site';
---
{/* Le montage est la ressource du plus grand élément peint de la page (le titre
    est détouré DEDANS) et c'est aussi le plus gros fichier du site : tant qu'il
    n'arrive pas, « DAILY POP » ne peut pas se peindre. Or il est annoncé par un
    `background-image` en style inline, que l'analyseur de préchargement ne lit
    pas : il ne partait qu'une fois le DOM construit, sans indice de priorité.
    Un preload dans le corps est vu par l'analyseur comme s'il était dans le
    head — le générique est le premier bloc de <main>, il tient dans le premier
    paquet — et il n'a pas à voyager jusqu'au layout, qui le poserait alors sur
    les SEPT pages qui n'ont pas de générique.
    DEUX preloads et non un : le CSS choisit le montage réduit ou la HD selon la
    largeur, le `media` du preload doit poser EXACTEMENT la même condition —
    sinon le navigateur préchargerait une image que la page n'affiche pas, et
    téléchargerait les deux. */}
<link rel="preload" as="image" href={MONTAGE.src} media="(max-width: 1023px)" fetchpriority="high" />
<link rel="preload" as="image" href={MONTAGE_HD.src} media="(min-width: 1024px)" fetchpriority="high" />
<section class="gen letterbox" id="generique" aria-label="Daily Pop Society, le bar pop culture de Charleroi">
  <div class="gen__grain" aria-hidden="true"></div>
  <p class="gen__presente">Daily Pop Society présente</p>

  <h1 class="gen__titre">
    <span class="gen__nom">
      {/* data-montage-ratio : le <script> client est compilé à part, il ne peut
          pas importer les données Astro. Le ratio du montage voyage donc par le
          markup, et le script en déduit la largeur réelle d'une tuile. */}
      <span
        class="gen__nom-fill"
        aria-hidden="true"
        data-montage-ratio={MONTAGE.largeur / MONTAGE.hauteur}
        style={`--montage: url(${MONTAGE.src}); --montage-hd: url(${MONTAGE_HD.src})`}
      >Daily Pop</span>
      <span class="gen__nom-blanc">Daily Pop</span>
    </span>
    <span class="gen__society">Society</span>
  </h1>


  <div class="gen__pied">
    {/* Le classement du mois du mini-jeu : rempli par borne.ts au boot, masqué
        tant que personne n'a marqué (ou si l'API ne répond pas). PREMIER ENFANT
        du pied et non frère absolu (comme prévu au plan) : posé en absolu, il
        chevauchait la title card dès que celle-ci passait sur deux lignes
        (mobile 390). En ligne pleine du pied, il se range TOUJOURS au-dessus,
        quelle que soit la hauteur prise en dessous. */}
    <p class="gen__top" id="gen-top" hidden></p>
    <p class="gen__scroll" aria-hidden="true"><span></span>Scroll pour lancer le générique</p>
    <a class="gen__carte" href="/events/">Ce mois-ci · <b>{LICENCE_DU_MOIS.nom}</b> · {LICENCE_DU_MOIS.dates}</a>
    {/* START est un <button> et non un lien : il n'ouvre pas une page, il pose
        un calque. `hidden` par défaut — sans JS le jeu n'existe pas, la
        promesse ne doit donc pas s'afficher ; borne.ts le révèle au boot. */}
    <button type="button" class="gen__start" id="gen-start" hidden>Start</button>
    <p class="gen__lieu">{IDENTITE.ville} · Terre-6000</p>
  </div>
</section>

<style>
  .gen {
    position: relative; overflow: hidden;
    /* Repli empilé : les navigateurs sans svh gardent vh, les autres écrasent. */
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    /* .gen est déclaré « surface sombre » dans global.css : il lit ses jetons
       (--txt, --focus, --accent) comme n'importe quelle autre surface. */
    color: var(--txt);
    background: radial-gradient(ellipse at 50% 60%, #9A2334 0%, var(--bdx) 45%, var(--bdx-deep) 100%);
  }
  .gen__grain {
    position: absolute; inset: 0; opacity: 0.16; pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.35) 0.6px, transparent 0.8px);
    background-size: 4px 4px;
  }
  .gen__presente {
    position: absolute; left: 0; right: 0; top: clamp(96px, 15vh, 140px);
    text-align: center; font-size: 0.78rem; letter-spacing: 0.42em; text-transform: uppercase; opacity: 0.85;
  }
  .gen__titre {
    position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-54%);
    text-align: center; font-family: var(--font-title); font-weight: 400; text-transform: uppercase; z-index: 2;
  }
  .gen__nom { display: block; position: relative; font-size: clamp(4.4rem, 15vw, 15rem); line-height: 0.86; letter-spacing: 0.02em; }
  /* La couche de remplissage est la doublure du nom : au repos elle est
     invisible et c'est le nom blanc qui s'affiche (état statique sans JS).
     Ce opacity:0-là n'est donc PAS un état d'intro, il ne dépend pas de
     js-intro : sans JS, cette couche ne doit jamais apparaître. */
  .gen__nom-fill {
    position: absolute; inset: 0; opacity: 0;
    /* Les deux URL arrivent en variables posées sur l'élément (Astro les
       calcule, le CSS scopé ne peut pas les écrire) : c'est le CSS qui CHOISIT,
       pas le markup — un `background-image` en style inline aurait battu toute
       règle de feuille, et le desktop serait resté sur le montage réduit. */
    background-image: var(--montage);
    background-size: auto 100%; background-repeat: repeat-x; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.5);
  }
  /* Au-delà de 1024 px, le titre monte vers ses 240 px CSS : sur un écran dense
     cela réclame 480 pixels réels, exactement la hauteur du montage HD. Même
     seuil que le `media` des deux preloads — les deux se contredisant, le
     navigateur téléchargerait les deux montages. */
  @media (min-width: 1024px) {
    .gen__nom-fill { background-image: var(--montage-hd); }
  }
  /* text-shadow et non filter: drop-shadow — le filtre crée un contexte
     d'empilement et repasse tout le nom par le compositeur à chaque frame. */
  .gen__nom-blanc { position: relative; color: var(--blanc); text-shadow: 0 6px 0 rgba(0, 0, 0, 0.18); }
  .gen__society { display: block; margin-top: 0.35em; font-size: clamp(1.3rem, 3.6vw, 2.6rem); letter-spacing: 0.6em; text-indent: 0.6em; }
  /* flex-wrap + center : START s'installe à côté de la title card et passe
     SOUS elle quand la ligne devient trop étroite (mobile). Les deux mentions
     latérales gardant `flex: 1 1 0`, il ne reste aucun espace libre sur une
     ligne pleine : `center` s'y comporte donc exactement comme l'ancien
     `space-between`, il ne sert que la ligne repliée. */
  .gen__pied {
    position: absolute; left: var(--gutter); right: var(--gutter); bottom: clamp(34px, 5vh, 48px);
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 16px; z-index: 3;
    font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .gen__start {
    flex: 0 0 auto;
    font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.24em; text-transform: uppercase;
    padding: 9px 22px; border: var(--bord); background: var(--rouge); color: var(--blanc);
    box-shadow: var(--ombre-btn) 4px 4px 0; cursor: pointer;
  }
  .gen__start:hover { transform: translate(-2px, -2px); }
  /* Le classement du mois : une ligne pleine, donc une ligne à elle seule. */
  .gen__top {
    flex: 1 0 100%; margin-bottom: 2px;
    text-align: center; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.9;
  }
  /* La title card doit tomber au MILIEU du hero : space-between la décalait,
     les deux mentions latérales n'ayant pas la même largeur. On leur donne la
     même part de place, la carte garde la sienne. */
  .gen__scroll, .gen__lieu { flex: 1 1 0; }
  /* « Scroll pour lancer le générique » ne dit vrai QUE là où le générique est
     scrubé : caché par défaut, il n'apparaît que si le script a posé
     .gen--scrub (branche desktop). Sans JS, sans GSAP ou en mobile, la phrase
     promettrait une animation qui n'existe pas. */
  .gen__scroll { display: none; flex-direction: column; align-items: flex-start; gap: 6px; opacity: 0.75; font-size: 0.7rem; }
  .gen--scrub .gen__scroll { display: flex; }
  .gen__scroll span { display: block; width: 1px; height: 28px; background: var(--blanc); }
  .gen__lieu { text-align: right; opacity: 0.8; }
  .gen__carte {
    /* 0 1 auto, pas 0 0 auto : sur un écran étroit la carte doit pouvoir
       rétrécir et passer à la ligne, sinon elle sort du hero des deux côtés. */
    flex: 0 1 auto;
    font-family: var(--font-title); font-size: clamp(0.9rem, 1.4vw, 1.15rem); letter-spacing: 0.14em;
    border: 1.5px solid var(--blanc); padding: 8px 16px; background: rgba(0, 0, 0, 0.25);
    color: var(--blanc); text-decoration: none; text-align: center;
  }
  .gen__carte b { color: var(--rose); font-weight: 400; }
  .gen__carte:hover { background: var(--blanc); color: var(--noir); }
  .gen__carte:hover b { color: var(--bdx); }
  @media (max-width: 600px) {
    /* .gen__scroll est déjà caché par défaut : seule sa variante scrub, qu'un
       redimensionnement aurait laissée derrière, doit être refermée ici. */
    .gen--scrub .gen__scroll, .gen__lieu { display: none; }
    .gen__pied { justify-content: center; }
    .gen__carte { font-size: 0.82rem; letter-spacing: 0.06em; padding: 8px 12px; line-height: 1.4; }
    .gen__top { font-size: 0.62rem; }
  }
  /* Pré-paint (class js-intro posée avant le premier rendu par index.astro) :
     les éléments que GSAP fait entrer partent invisibles — aucun flash.
     Le h1 (nom blanc + « Society ») ne reçoit QUE opacity : il doit rester dans
     l'arbre d'accessibilité, un h1 en visibility:hidden n'est plus annoncé. */
  :global(html.js-intro) .gen__nom-blanc,
  :global(html.js-intro) .gen__society { opacity: 0; }
  /* À t=0 le nom rempli de logos est la seule chose à voir : le pré-paint le
     montre tout de suite (GSAP le confirme par un set à 0 de la timeline).
     Sans JS, js-intro n'existe pas et c'est le nom blanc qui s'affiche. */
  :global(html.js-intro) .gen__nom-fill { opacity: 1; }
  /* La carte, elle, est un LIEN : transparente mais toujours dans l'ordre de
     tabulation, elle se faisait atteindre au clavier avant d'exister (lien
     fantôme). visibility:hidden la retire du parcours ET du pointeur ; GSAP
     prend le relais avec autoAlpha, qui pilote les deux propriétés. */
  :global(html.js-intro) .gen__carte { opacity: 0; visibility: hidden; }
  /* START et la ligne du classement entrent AVEC la title card (même tween) :
     même pré-paint qu'elle, visibility comprise — un bouton transparent mais
     focusable serait le même « lien fantôme » que la carte avant correction. */
  :global(html.js-intro) .gen__start,
  :global(html.js-intro) .gen__top { opacity: 0; visibility: hidden; }
  /* Filet : si un focus l'atteint malgré tout (recherche dans la page,
     extension, restauration de scroll), elle se montre plutôt que de laisser
     un contour posé sur du vide. */
  .gen__carte:focus-visible,
  .gen__start:focus-visible { opacity: 1 !important; visibility: visible !important; }
</style>

<script>
  import { REDUCED, isDesktop, loadGsap } from '../lib/motion';

  if (!REDUCED && document.documentElement.classList.contains('js-intro')) {
    loadGsap()
      .then(({ gsap, ScrollTrigger }) => {
        /* Le garde-fou de 3 s a pu tomber avant nous (GSAP lent à arriver) : la
           page est alors déjà dans son état final. Reposer les états initiaux
           la ferait clignoter, et rejouer l'intro après coup n'a plus de sens. */
        if (!document.documentElement.classList.contains('js-intro')) return;

        const gen = document.querySelector<HTMLElement>('.gen');
        if (!gen) return;
        const nom = gen.querySelector('.gen__nom');
        const fill = gen.querySelector<HTMLElement>('.gen__nom-fill');
        const blanc = gen.querySelector('.gen__nom-blanc');
        const society = gen.querySelector('.gen__society');
        const carte = gen.querySelector('.gen__carte');
        const presente = gen.querySelector('.gen__presente');
        const scroll = gen.querySelector('.gen__scroll');
        /* La title card, le bouton START du jeu et la ligne « Top du mois »
           n'ont qu'une entrée pour trois : ils apparaissent au même temps du
           générique. Filtre typé (et non `.filter(Boolean)`) : GSAP refuse un
           tableau qui peut contenir null, et `Boolean` ne narrowe pas. */
        const start = gen.querySelector('.gen__start');
        const top = gen.querySelector('.gen__top');
        const entree = [carte, start, top].filter((el): el is Element => el !== null);

        /* Largeur RÉELLE d'une tuile du montage : background-size: auto 100% met
           l'image à la hauteur de la couche, sa largeur suit donc le ratio. Le
           -1600px en dur d'avant ne parcourait pas le même nombre de tuiles
           selon la taille du titre (clamp de 4,4rem à 15rem).
           Fonction et non constante : la hauteur du titre suit le viewport,
           la course doit donc être RELUE à chaque refresh. */
        const ratio = fill ? Number(fill.dataset.montageRatio) || 1 : 1;
        const remplissage = () => `-${3 * (fill ? fill.offsetHeight : 0) * ratio}px`;

        /* Les trois temps du générique, en fractions de la timeline (0 → 1) :
           1. 0 → 0.66  le défilé de logos traverse « DAILY POP » de plus en
              plus vite (trois tuiles du montage, accélération power1.in), le
              nom se resserre d'un cheveu (1,06 → 1) : c'est LUI le générique
           2. 0.64 → 0.72  le nom se fige en blanc
           3. 0.72 → 1  « SOCIETY » se compose, title card, START, top du mois
           `set` à 0 et non fromTo : à t=0 (scroll 0, ou avant l'intro mobile)
           le nom rempli doit déjà être là — c'est la seule chose à voir. */
        const composer = (tl: ReturnType<typeof gsap.timeline>, mobile: boolean) => {
          const d = mobile ? 2.6 : 1; // durée totale : secondes en mobile, fraction en scrub
          tl.set(fill, { opacity: 1 }, 0)
            .fromTo(fill, { backgroundPositionX: '0px' }, { backgroundPositionX: remplissage, duration: 0.66 * d, ease: 'power1.in' }, 0)
            .fromTo(nom, { scale: 1.06 }, { scale: 1, duration: 0.66 * d, ease: 'power1.in' }, 0)
            .to(presente, { opacity: 0, y: -20, duration: 0.1 * d }, 0.45 * d)
            .fromTo(blanc, { opacity: 0 }, { opacity: 1, duration: 0.1 * d }, 0.64 * d)
            .to(fill, { opacity: 0, duration: 0.08 * d }, 0.68 * d)
            .fromTo(society, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.1 * d }, 0.72 * d)
            /* autoAlpha et non opacity : la carte est un LIEN et START un
               BOUTON, ils doivent rester non focusables et non cliquables tant
               qu'ils ne sont pas apparus. */
            .fromTo(entree, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.1 * d }, 0.86 * d)
            .to(scroll, { opacity: 0, duration: 0.06 * d }, 0.9 * d);
        };

        if (isDesktop()) {
          /* Le navigateur restaure la position de scroll AVANT que le pin
             n'existe : rechargée à mi-page, la page se retrouvait rendue à un
             endroit qui n'était plus le même une fois les 250 % de hauteur du
             pin insérés — le lecteur reprenait ailleurs qu'où il était. On
             reprend la main : la page rouvre en haut, le générique rejoue. */
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          /* …et il faut le dire à ScrollTrigger, sinon il le défait : il a
             mémorisé la valeur au registerPlugin (« auto ») et la REPOSE à
             chaque refresh (ScrollTrigger.js, _clearScrollMemory). L'assignation
             seule tenait 200 ms. clearScrollMemory fait les deux d'un coup. */
          ScrollTrigger.clearScrollMemory('manual');
          /* Desktop : scène épinglée, scrubée. end = 250 % de hauteur de viewport. */
          const tl = gsap.timeline({
            defaults: { ease: 'power2.out' },
            /* invalidateOnRefresh : la valeur fonctionnelle (course du
               remplissage) n'est résolue qu'UNE fois à la création.
               Sans ça, un passage de 1280 à 1920 px garde l'ancienne course et
               ne parcourt plus le même nombre de tuiles — le défaut même qu'on vient de
               fermer. Le refresh de ScrollTrigger les fait recalculer. */
            scrollTrigger: { trigger: gen, start: 'top top', end: '+=250%', scrub: 0.6, pin: true, invalidateOnRefresh: true },
          });
          composer(tl, false);
          /* L'invite « scroll pour lancer le générique » ne se montre que là où
             elle dit vrai : ici, et seulement une fois le scrub en place. */
          gen.classList.add('gen--scrub');
          /* Duo obligatoire après chaque création de pin (cf. motion.ts) */
          ScrollTrigger.sort();
          ScrollTrigger.refresh();

          /* ===== Retour arrière : reprendre la lecture où on l'a laissée =====
             Le `scrollRestoration = 'manual'` ci-dessus ne fait pas le tri : il
             enlève AUSSI la restauration au retour arrière, la seule qu'on
             voulait garder. Un lecteur arrivé au bas de l'accueil, parti voir la
             carte et revenu se retrouvait rejeté tout en haut, générique compris.
             On la refait donc à la main, mais seulement quand le navigateur dit
             qu'il s'agit d'un retour (`back_forward`) : sur une ouverture
             normale de l'accueil, la page doit s'ouvrir sur le générique.
             APRÈS le refresh, jamais avant : c'est lui qui insère les 250 % de
             hauteur du pin, donc qui donne son sens à une position de scroll.
             sessionStorage peut lever (mode privé strict, cookies bloqués) :
             une position de lecture ne vaut pas de casser l'intro.
             ⚠️ Cette mémorisation n'existe QUE sur desktop avec GSAP chargé —
             c'est la seule branche qui coupe la restauration native. Partout
             ailleurs (mobile, sans JS, reduced-motion, GSAP en échec), le
             navigateur restaure seul et ce code ne tourne jamais. */
          const cleScroll = `dps:scroll:${location.pathname}`;
          try {
            const memo = sessionStorage.getItem(cleScroll);
            /* Consommée dans TOUS les cas, même sans restauration : une position
               laissée derrière se rejouerait à la prochaine ouverture. */
            sessionStorage.removeItem(cleScroll);
            const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
            /* `nav?.type === 'back_forward'` et non `!nav || …` : sans Navigation
               Timing (vieux navigateur, API désactivée) on ne SAIT pas d'où
               vient la visite — et le repli d'avant restaurait alors la position
               à chaque ouverture normale, générique sauté. En cas de doute, on
               ouvre sur le générique : c'est le comportement voulu par défaut. */
            if (memo && nav?.type === 'back_forward') {
              window.scrollTo({ top: Number(memo), behavior: 'instant' });
            }
          } catch {}
          /* pagehide et non beforeunload : c'est le seul événement qui parte
             aussi quand la page entre en cache arrière/avant, et le seul que
             Safari mobile émette de façon fiable. */
          addEventListener('pagehide', () => {
            try { sessionStorage.setItem(cleScroll, String(window.scrollY)); } catch {}
          });
          /* Retour depuis le cache arrière/avant : la page n'est pas réexécutée,
             le navigateur a REMIS lui-même la position — et notre mémo, écrit
             par le pagehide qui l'y a envoyée, resterait derrière et se
             rejouerait à la prochaine ouverture normale. On le jette. */
          window.addEventListener('pageshow', (e) => {
            if (e.persisted) { try { sessionStorage.removeItem(cleScroll); } catch {} }
          });
        } else {
          /* Mobile / tablette : intro courte au chargement, pas de pin (fragile au tactile) */
          composer(gsap.timeline({ defaults: { ease: 'power3.out' } }), true);
        }

        /* GSAP a posé tous les états initiaux : le pré-paint peut tomber. */
        clearTimeout(window.__introSecours);
        document.documentElement.classList.remove('js-intro');
      })
      .catch(() => {
        /* GSAP n'a pas chargé (réseau, bloqueur d'extension) : plutôt que
           d'attendre les 3 s du garde-fou, on rend le hero statique tout de
           suite. Le générique est un bonus, jamais une condition de lecture. */
        clearTimeout(window.__introSecours);
        document.documentElement.classList.remove('js-intro');
      });
  }
</script>
