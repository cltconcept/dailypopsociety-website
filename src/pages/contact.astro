---
import Base from '../layouts/Base.astro';
import TitleCard from '../components/TitleCard.astro';
import Horaires from '../components/Horaires.astro';
import LienExterne from '../components/LienExterne.astro';
import { IDENTITE } from '../data/site';

/* La page de contact du bar, rattachée par `@id` à la fiche d'établissement
   que Base.astro publie sur TOUTES les pages : on ne redéclare pas l'adresse
   et les horaires ici, on pointe la fiche existante. */
const schemas = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: { '@id': `${IDENTITE.domaine}/#bar` },
}];
---
<Base title="Contact et horaires — Daily Pop Society, Quai Arthur Rimbaud 9, Charleroi" description="Daily Pop Society, Quai Arthur Rimbaud 9 à 6000 Charleroi. Horaires d'ouverture, téléphone, e-mail, Instagram et Facebook. Réservation des soirées JDR par téléphone ou Messenger." schemas={schemas}>
  <TitleCard kicker="Chapitre 5 · Nous trouver" variante="noir">Quai Arthur Rimbaud 9,<br /><em>Charleroi</em><Fragment slot="copy">Sur le quai, à deux pas du centre. Pas de réservation en ligne : un coup de fil, un message, et on te garde une place.</Fragment><Fragment slot="actions"><LienExterne href={IDENTITE.itineraire} class="btn">Itinéraire</LienExterne><a class="btn btn--ghost" href={`tel:${IDENTITE.telephoneIntl}`}>Appeler<span class="sr-only"> le {IDENTITE.telephone}</span></a></Fragment></TitleCard>

  <section class="section">
    <div class="container ct">
      <div>
        <span class="kicker">Horaires</span>
        <h2 class="titre titre--md">Quand <em>on est là</em></h2>
        <div class="ct__horaires"><Horaires /></div>
      </div>
      <div class="bloc-creme">
        <h2 class="kicker">Coordonnées</h2>
        <p class="ct__adresse">{IDENTITE.rue}<br />{IDENTITE.codePostal} {IDENTITE.ville}, Belgique</p>
        <dl class="ct__liste">
          <dt>Téléphone</dt><dd><a href={`tel:${IDENTITE.telephoneIntl}`}>{IDENTITE.telephone}</a></dd>
          <dt>E-mail</dt><dd><a href={`mailto:${IDENTITE.email}`}>{IDENTITE.email}</a></dd>
          <dt>Instagram</dt><dd><LienExterne href={IDENTITE.instagram}>@dailypopsociety</LienExterne></dd>
          <dt>Facebook</dt><dd><LienExterne href={IDENTITE.facebook}>Daily Pop Society</LienExterne></dd>
        </dl>
        <p class="ct__resa">Soirées JDR sur réservation uniquement : par téléphone ou par Messenger. Les groupes et les rassemblements cosplay, pareil, on s'organise ensemble.</p>
        <p class="hand ct__hand">Cosplay bienvenu, tout le temps.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .ct__adresse { font-family: var(--font-title); font-size: 1.7rem; line-height: 1.05; text-transform: uppercase; }
  .ct__liste { margin-top: 22px; display: grid; grid-template-columns: auto 1fr; gap: 8px 18px; }
  .ct__liste dt { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); align-self: center; }
  /* Le poids se pose sur le <dd>, pas sur le <a> : les liens externes sont
     rendus par LienExterne, un autre composant — le scope de CETTE page ne les
     atteint pas, et deux des quatre lignes restaient en poids normal.
     `overflow-wrap: anywhere` : l'e-mail ne doit pas élargir la page. */
  .ct__liste dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .ct__resa { margin-top: 22px; color: var(--txt-doux); line-height: 1.6; }
  .ct__horaires { margin-top: 28px; }
  .ct__hand { margin-top: 18px; }
  @media (max-width: 960px) { .ct { grid-template-columns: 1fr; } }
  /* Sous 600 px, les deux colonnes de la liste ne tiennent plus : le terme
     passe au-dessus de sa valeur. */
  @media (max-width: 600px) { .ct__liste { grid-template-columns: 1fr; gap: 2px 0; } }
</style>
