  <TitleCard kicker="Erreur 404" variante="noir" letterbox>
    Cette page n'existe pas<br /><em>dans ce multivers.</em>
    <Fragment slot="copy">Mauvaise dimension, mauvaise URL. Repars de l'accueil, ou va voir ce qu'il se passe ce mois-ci.</Fragment>
    <Fragment slot="actions"><a class="btn" href="/">Retour à l'accueil</a><a class="btn btn--ghost" href="/events/">Les events</a></Fragment>
  </TitleCard>
</Base>
