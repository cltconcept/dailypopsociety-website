---
import '@fontsource/anton';
import '@fontsource-variable/inter';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IDENTITE } from '../data/site';
import { schemaBar } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Image de partage, chemin absolu depuis la racine du site. */
  image?: string;
  /** Schémas JSON-LD ajoutés APRÈS le schéma de l'établissement, toujours présent. */
  schemas?: object[];
}
const { title, description, noindex = false, image = '/media/og.png', schemas } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
/* Une page non indexée ne publie pas de données structurées : elles ne
   serviraient qu'à contredire le noindex. */
const listeSchemas = noindex ? [] : [schemaBar(og.toString()), ...(schemas ?? [])];
/* `<` échappé : une chaîne de données ne doit jamais pouvoir fermer le <script>. */
const enJson = (x: object) => JSON.stringify(x).replace(/</g, '\\u003c');
---
<html lang="fr-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#7B1E2B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={antonWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {/* Dimensions ANNONCÉES : sans elles, un réseau qui n'a pas encore chargé
        l'image réserve une vignette carrée et le grand format arrive en
        sautant. Elles décrivent /media/og.png (1200×630) — une page qui
        passerait une autre `image` devrait les revoir. `og:image:alt` est lu
        par les lecteurs d'écran des réseaux : l'image porte le nom du bar en
        toutes lettres, l'alternative doit dire la même chose. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daily Pop Society — le bar pop culture de Charleroi" />
    <meta property="og:site_name" content={IDENTITE.nom} />
    <meta property="og:locale" content="fr_BE" />
    <meta name="twitter:card" content="summary_large_image" />
    {listeSchemas.map((s) => <script is:inline type="application/ld+json" set:html={enJson(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { REDUCED, loadGsap, onFirstIdle, bootReveals } from '../lib/motion';
      if (!REDUCED && document.querySelector('[data-reveal]')) {
        /* .catch : GSAP peut ne jamais arriver (réseau, bloqueur). Les reveals
           sont un bonus — le contenu est déjà à l'écran — mais un rejet non
           géré remonterait en erreur de console sur toutes les pages. */
        onFirstIdle(() => { loadGsap().then(bootReveals).catch(() => {}); });
      }
    </script>
  </body>
</html>
